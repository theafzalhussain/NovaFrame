# Copy to `.env` (git-ignored) and fill in. Every value is optional.

# --- API server (Node) -------------------------------------------------
PORT=4000

# --- Database ----------------------------------------------------------
# Leave both TURSO_* empty for local development: the server then uses a
# local SQLite file (server/webxstudio.db, or DB_PATH below).
#
# Set them in production (Render) to use the hosted Turso database, so data
# survives restarts and deploys. Get both from https://turso.tech →
# your database → "Connect" (URL) and "Create Token" (auth token).
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJ...
#
# Embedded replica (optional, Turso mode only). Keeps a full local copy of the
# database on disk: reads are answered locally in microseconds instead of over
# the network, while writes still go to the primary and are applied locally too.
# Needs a writable filesystem, and pulls the whole database (including uploaded
# images) on boot — so it trades start-up time for read latency. Off by default.
# TURSO_EMBEDDED_REPLICA=1
# TURSO_SYNC_INTERVAL=60              # seconds between background pulls
# TURSO_REPLICA_PATH=./server/turso-replica.db
#
# How long the in-memory site-content cache may go without re-checking the
# stored version, in milliseconds. Edits made through the admin console take
# effect immediately regardless; this only bounds how long an edit made by
# another instance or a script can take to appear. Default 5000.
# CONTENT_CACHE_TTL_MS=5000
#
# Where the local SQLite file lives (default: server/webxstudio.db)
# DB_PATH=./server/webxstudio.db
# Comma-separated list of sites allowed to call the API (empty = any origin)
# CORS_ORIGIN=https://webxstudio.me,https://www.webxstudio.me
# Set to 1 when running behind one reverse proxy (Render, Nginx, Cloudflare)
# TRUST_PROXY=1
SESSION_DAYS=7
# Chart day buckets in minutes from UTC (330 = IST)
TZ_OFFSET_MINUTES=330

# --- First owner account (used only when no admin exists yet) ----------
ADMIN_EMAIL=admin@webxstudio.me
# 10+ characters. Leave empty to have a strong one generated and printed once.
ADMIN_PASSWORD=
ADMIN_NAME=Afzal Hussain

# --- Email notifications (optional) ------------------------------------
# Pick ONE backend. Priority: BREVO_API_KEY → RESEND_API_KEY → SMTP_HOST.
# The two API options send over HTTPS (port 443), so they work on Railway
# Hobby/Trial, which blocks outbound SMTP ports (587/465).
#
# Option 1 — Brevo HTTP API (recommended: reuses your existing Brevo account).
#   Brevo dashboard → SMTP & API → API Keys → create/copy the "xkeysib-..." key
#   (this is the HTTP API key, NOT the "xsmtpsib-..." SMTP key).
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM="WebXstudio <you@yourdomain.com>"   # must be a VERIFIED Brevo sender
#
# Option 2 — Resend HTTP API. Free tier: 3,000/month. Sign up at resend.com.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="WebXstudio <noreply@yourdomain.com>"  # VERIFIED domain in Resend
#   (Leave MAIL_FROM empty to send from onboarding@resend.dev for testing.)
#
# Option 3 — SMTP (works locally; blocked on Railway Hobby/Trial).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=xxxxxxxx@smtp-brevo.com     # Brevo SMTP login
# SMTP_PASS=xsmtpsib-...                 # Brevo SMTP key (NOT the xkeysib API key)
# MAIL_FROM="WebXstudio <you@yourdomain.com>"   # must be a verified Brevo sender
#
# Shared (all backends):
# NOTIFY_EMAIL=you@gmail.com             # where lead/booking/payment alerts arrive
# SEND_CONFIRMATIONS=true

# --- Payments (Razorpay) -----------------------------------------------
# Test keys start with rzp_test_ ; live keys start with rzp_live_.
# The key id is sent to the browser per order; the secret never leaves the server.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# PAYMENT_CURRENCY=INR
# Optional safety net: Razorpay Dashboard → Webhooks → https://<your-domain>/api/payments/webhook
# (events: payment.captured, order.paid) using this same secret.
# RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- Student Partner & Campus Ambassador program (optional) -------------
# Commission is credited by the server only from verified client payments.
# PARTNER_COMMISSION_PERCENT=20     # 1–50, applied to every verified installment
# PARTNER_HOLD_DAYS=7               # refund-safety window before commission can be withdrawn
# PARTNER_MIN_PAYOUT=500            # minimum withdrawal, in rupees
# PARTNER_ATTRIBUTION_DAYS=180      # first partner to bring a client keeps the credit this long

# --- Public site URL ---------------------------------------------------
# IMPORTANT FOR SEO. Set this in production to your single canonical origin.
# It pins every canonical URL, Open Graph URL and sitemap entry to one
# hostname, so the same page reached via a platform subdomain
# (*.onrender.com) or a bare-vs-www mismatch cannot be indexed twice and
# split its own ranking. Also used for links inside emails.
# No trailing slash. Pick ONE of bare or www and redirect the other to it.
# SITE_URL=https://webxstudio.me

# --- Frontend (Vite, read at build time) -------------------------------
# Point the site at a separately hosted API (default: same-origin /api)
# VITE_API_URL=https://api.webxstudio.me/api
