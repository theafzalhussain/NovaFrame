# Copy to `.env` (git-ignored) and fill in. Every value is optional.

# --- API server (Node) -------------------------------------------------
PORT=4000
# Where the SQLite database lives (default: server/novaframe.db)
# DB_PATH=./server/novaframe.db
# Comma-separated list of sites allowed to call the API (empty = any origin)
# CORS_ORIGIN=https://novaframe.studio,https://www.novaframe.studio
# Set to 1 when running behind one reverse proxy (Render, Nginx, Cloudflare)
# TRUST_PROXY=1
SESSION_DAYS=7
# Chart day buckets in minutes from UTC (330 = IST)
TZ_OFFSET_MINUTES=330

# --- First owner account (used only when no admin exists yet) ----------
ADMIN_EMAIL=admin@novaframe.studio
# 10+ characters. Leave empty to have a strong one generated and printed once.
ADMIN_PASSWORD=
ADMIN_NAME=Afzal Hussain

# --- Email notifications (optional, any SMTP provider) -----------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Novaframe Studio <you@gmail.com>"
# NOTIFY_EMAIL=you@gmail.com
# SEND_CONFIRMATIONS=true

# --- Frontend (Vite, read at build time) -------------------------------
# Point the site at a separately hosted API (default: same-origin /api)
# VITE_API_URL=https://api.novaframe.studio/api
