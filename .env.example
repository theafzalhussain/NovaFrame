# Copy to `.env` (git-ignored) and fill in. Every value is optional.

# --- API server (Node) -------------------------------------------------
PORT=4000
# Where the SQLite database lives (default: server/novaframe.db)
# DB_PATH=./server/novaframe.db
# Comma-separated list of sites allowed to call the API (empty = any origin)
# CORS_ORIGIN=https://novaframe.studio,https://www.novaframe.studio
# Set to 1 when running behind one reverse proxy (Render, Nginx, Cloudflare)
# TRUST_PROXY=1
SESSION_DAYS=7
# Chart day buckets in minutes from UTC (330 = IST)
TZ_OFFSET_MINUTES=330

# --- First owner account (used only when no admin exists yet) ----------
ADMIN_EMAIL=admin@novaframe.studio
# 10+ characters. Leave empty to have a strong one generated and printed once.
ADMIN_PASSWORD=
ADMIN_NAME=Afzal Hussain

# --- Email notifications (optional) ------------------------------------
# Pick ONE backend. Priority: BREVO_API_KEY → RESEND_API_KEY → SMTP_HOST.
# The two API options send over HTTPS (port 443), so they work on Railway
# Hobby/Trial, which blocks outbound SMTP ports (587/465).
#
# Option 1 — Brevo HTTP API (recommended: reuses your existing Brevo account).
#   Brevo dashboard → SMTP & API → API Keys → create/copy the "xkeysib-..." key
#   (this is the HTTP API key, NOT the "xsmtpsib-..." SMTP key).
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM="Novaframe Studio <you@yourdomain.com>"   # must be a VERIFIED Brevo sender
#
# Option 2 — Resend HTTP API. Free tier: 3,000/month. Sign up at resend.com.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Novaframe Studio <noreply@yourdomain.com>"  # VERIFIED domain in Resend
#   (Leave MAIL_FROM empty to send from onboarding@resend.dev for testing.)
#
# Option 3 — SMTP (works locally; blocked on Railway Hobby/Trial).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=xxxxxxxx@smtp-brevo.com     # Brevo SMTP login
# SMTP_PASS=xsmtpsib-...                 # Brevo SMTP key (NOT the xkeysib API key)
# MAIL_FROM="Novaframe Studio <you@yourdomain.com>"   # must be a verified Brevo sender
#
# Shared (all backends):
# NOTIFY_EMAIL=you@gmail.com             # where lead/booking/payment alerts arrive
# SEND_CONFIRMATIONS=true

# --- Payments (Razorpay) -----------------------------------------------
# Test keys start with rzp_test_ ; live keys start with rzp_live_.
# The key id is sent to the browser per order; the secret never leaves the server.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# PAYMENT_CURRENCY=INR
# Optional safety net: Razorpay Dashboard → Webhooks → https://<your-domain>/api/payments/webhook
# (events: payment.captured, order.paid) using this same secret.
# RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- Public site URL (optional) ----------------------------------------
# Enables "Book a call" / admin links inside emails, e.g. https://novaframe.studio
# SITE_URL=https://novaframe.studio

# --- Frontend (Vite, read at build time) -------------------------------
# Point the site at a separately hosted API (default: same-origin /api)
# VITE_API_URL=https://api.novaframe.studio/api
