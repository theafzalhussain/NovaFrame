  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
