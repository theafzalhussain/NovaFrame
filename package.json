{
  "name": "novaframe-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "admin:reset": "tsx server/reset-admin.ts",
    "team:fix-links": "tsx server/fix-team-links.ts",
