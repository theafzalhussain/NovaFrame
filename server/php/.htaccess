# Route every /api/* request to api.php (Apache / cPanel / Hostinger)
Options -Indexes
RewriteEngine On

# Keep the Authorization header (some hosts strip it before PHP sees it)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Never serve secrets or seed data directly
RewriteRule ^(\.env|seed\.json|config\.php|schema\.sql)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ api.php [QSA,L]
